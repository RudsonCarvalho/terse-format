MCP google_drive v2.0
  TOOL drive_list_files
    PURPOSE: list files in Google Drive
    IN: folder_id:string?, query:string?, max_results:int?
    OUT: files:array[object]
    ERR: auth_failed | quota_exceeded | not_found
    WHEN: user requests to list or browse files in Google Drive
    TAGS: drive, files, list

  TOOL drive_read_file
    PURPOSE: read file content from Google Drive
    IN: file_id:string
    OUT: content:string, mime_type:string
    ERR: auth_failed | not_found | permission_denied
    WHEN: user wants to read or open a file from Google Drive
    TAGS: drive, files, read
